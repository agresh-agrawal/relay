{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/download", "destination": "https://github.com/agresh-agrawal/relay/releases/latest/download/Relay-Setup.exe", "permanent": false },
    { "source": "/portable", "destination": "https://github.com/agresh-agrawal/relay/releases/latest/download/Relay-Portable.exe", "permanent": false },
    { "source": "/github", "destination": "https://github.com/agresh-agrawal/relay", "permanent": false }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
